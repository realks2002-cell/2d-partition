<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ISOPLAN 3D — isometric cube, magenta accent on ink bg.
         Safe zone = inner 66x66 (adaptive icon recommendation). -->
    <group
        android:translateX="54"
        android:translateY="54"
        android:scaleX="0.32"
        android:scaleY="0.32">

        <!-- Top face (lightest) -->
        <path
            android:fillColor="#d43e76"
            android:pathData="M0,-60 L52,-30 L0,0 L-52,-30 Z" />

        <!-- Right face -->
        <path
            android:fillColor="#b93366"
            android:pathData="M0,0 L52,-30 L52,30 L0,60 Z" />

        <!-- Left face (darkest) -->
        <path
            android:fillColor="#8a2649"
            android:pathData="M0,0 L-52,-30 L-52,30 L0,60 Z" />

        <!-- Inner edge highlights -->
        <path
            android:strokeColor="#ffffff"
            android:strokeWidth="2"
            android:pathData="M0,0 L0,60 M0,0 L52,-30 M0,0 L-52,-30"
            android:fillColor="#00000000" />
    </group>
</vector>
